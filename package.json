{
  "name": "kanban",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "vite",
    "dev:backend": "convex dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "import": "node .claude/skills/jira-board-import/scripts/import-board.mjs",
    "week": "node .claude/skills/jira-board-import/scripts/checkpoint-week.mjs",
    "board": "convex run data:summary",
    "deploy": "node node_modules/@convex-dev/static-hosting/dist/cli/index.js deploy",
    "deploy:dev": "node node_modules/@convex-dev/static-hosting/dist/cli/index.js upload --build"
  },
  "dependencies": {
    "@convex-dev/static-hosting": "^0.2.1",
    "@dnd-kit/core": "^6.3.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
